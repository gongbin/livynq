{
  "name": "@livynq/plugin-zigbee",
  "version": "0.3.0",
  "description": "Built-in Zigbee coordinator support for Livynq (zigbee-herdsman)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongbin/livynq.git",
    "directory": "plugins/zigbee"
  },
  "homepage": "https://github.com/gongbin/livynq#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@livynq/sdk": "workspace:*",
    "yaml": "2.9.1",
    "zigbee-herdsman": "11.0.3",
    "zigbee-herdsman-converters": "26.118.0"
  },
  "devDependencies": {
    "@livynq/core": "workspace:*",
    "@livynq/plugin-host": "workspace:*"
  }
}
