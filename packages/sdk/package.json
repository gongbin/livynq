{
  "name": "@livynq/sdk",
  "version": "0.2.0",
  "description": "SDK for Livynq plugins",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongbin/livynq.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/gongbin/livynq#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@livynq/model": "workspace:*"
  }
}
