{
  "name": "livynq-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.6"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning apps/server/src/main.ts start",
    "dev": "node --disable-warning=ExperimentalWarning --watch apps/server/src/main.ts start --demo",
    "dev:web": "pnpm --filter @livynq/web dev",
    "build:web": "pnpm --filter @livynq/web build",
    "test": "node --disable-warning=ExperimentalWarning --test --test-force-exit --test-timeout=60000 --test-concurrency=1 \"packages/*/test/**/*.test.ts\" \"plugins/*/test/**/*.test.ts\" \"apps/server/test/**/*.test.ts\" \"apps/web/test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && pnpm --filter @livynq/web typecheck",
    "livynq": "node --disable-warning=ExperimentalWarning apps/server/src/main.ts",
    "build:sea": "node --disable-warning=ExperimentalWarning scripts/build-sea.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "^5.9.0"
  }
}
